From 8fef34c7d3259171de470f89e17717625a69cf30 Mon Sep 17 00:00:00 2001
From: Siddart Krishnaraju <rk.siddart@gmail.com>
Date: Tue, 13 Oct 2026 18:29:24 -0500
Subject: [PATCH] fix(workers-ai-provider): guard against dual-format chunk duplication in streaming

When certain Workers AI models emit SSE streaming chunks, the response payload
can contain both native fields (`chunk.response`, `chunk.tool_calls`) as well
as OpenAI-compatible choices (`chunk.choices[0].delta`).

Previously, the transform stream processed both representations sequentially
within the same chunk:
1. Enqueued `text-delta` with `chunk.response`.
2. Enqueued another `text-delta` with `chunk.choices[0].delta.content`.

This resulted in double token emissions (e.g. "word word") and duplicated tool
arguments over WebSocket streams.

This patch checks `hasChoicesDelta` to defer to `choices[0].delta` whenever present,
preventing redundant emissions while preserving full backwards compatibility
with legacy native-only chunks.
---
 packages/workers-ai-provider/src/streaming.ts | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/packages/workers-ai-provider/src/streaming.ts b/packages/workers-ai-provider/src/streaming.ts
index c12a84b..e34f9a1 100644
--- a/packages/workers-ai-provider/src/streaming.ts
+++ b/packages/workers-ai-provider/src/streaming.ts
@@ -166,8 +166,9 @@ export function createWorkersAIStreamTransform(
 				}
 
 				// --- Native format: top-level `response` field ---
+				const hasChoicesDelta = choices?.[0]?.delta != null;
 				const nativeResponse = chunk.response;
-				if (nativeResponse != null && nativeResponse !== "") {
+				if (!hasChoicesDelta && nativeResponse != null && nativeResponse !== "") {
 					const responseText = String(nativeResponse);
 					if (responseText.length > 0) {
 						if (bufferContentForSalvage) {
@@ -193,7 +194,7 @@ export function createWorkersAIStreamTransform(
 				}
 
 				// --- Native format: top-level `tool_calls` ---
-				if (Array.isArray(chunk.tool_calls)) {
+				if (!hasChoicesDelta && Array.isArray(chunk.tool_calls)) {
 					// Close active reasoning block before tool calls start
 					if (reasoningId) {
 						controller.enqueue({ type: "reasoning-end", id: reasoningId });
